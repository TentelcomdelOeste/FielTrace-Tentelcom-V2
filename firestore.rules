rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Firebase es el repositorio histórico de FieldTrace.
    // Los clientes autenticados pueden crear y actualizar registros,
    // pero nunca eliminarlos. El borrado local no se propaga a la nube.
    match /projects/{projectId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      // Temporalmente habilitado para las pruebas de eliminación de proyectos compartidos.
      allow delete: if request.auth != null;

      match /evidences/{evidenceId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null;
        // Temporalmente habilitado para las pruebas de eliminación de proyectos compartidos.
        allow delete: if request.auth != null;
      }

      allow delete: if false;
    }

    // Compatibilidad con la colección global antigua.
    match /evidences/{evidenceId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }
  }
}
